{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/progress-update.sh\"",
            "statusMessage": "진행 상황 기록 중..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/contract-lint.sh\"",
            "statusMessage": "sprint_contract.md 점검 중..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inventory-lint.sh\"",
            "statusMessage": "feature_inventory.json / test_priority_queue.md 점검 중..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/loop-guard.sh\"",
            "timeout": 30,
            "statusMessage": "검증 결과 확인 중..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-end.sh\"",
            "statusMessage": "세션 종료 처리 중..."
          }
        ]
      }
    ]
  }
}
