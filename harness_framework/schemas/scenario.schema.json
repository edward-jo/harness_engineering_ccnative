{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edward-jo/harness_engineering_ccnative/schemas/scenario.schema.json",
  "title": "P1 Happy Path Walkthrough Scenario",
  "description": "qa-surveyor 단계 4.5 산출물. Priority 1 feature 의 happy path 시나리오 설계. test-builder Walkthrough 모드가 읽어 Playwright MCP 명령으로 실행. evidence 는 evidence.json (별도 파일) 에 기록.",
  "type": "object",
  "required": ["feat_id", "feature_title", "scenario", "steps", "expected_observations"],
  "additionalProperties": false,
  "properties": {
    "feat_id": {
      "type": "string",
      "pattern": "^feat-inv-\\d+$",
      "description": "feature_inventory.json 의 feature id"
    },
    "feature_title": {
      "type": "string",
      "minLength": 1,
      "description": "feature_inventory.json 의 title 와 일치"
    },
    "scenario": {
      "type": "string",
      "minLength": 1,
      "description": "사용자 관점 happy path 한 문장 요약"
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth": {
          "type": "string",
          "description": "필요한 인증 자격 (역할 / env 변수). 예: 'OWNER 역할, TEST_USER_EMAIL/TEST_USER_PW env 필요'"
        },
        "data": {
          "type": "string",
          "description": "필요한 데이터 상태. 예: '기본 시드 + 매장 1건 존재'"
        },
        "external_deps": {
          "type": "string",
          "description": "외부 의존성 / mock 정책. 예: 'backend dev server 기동 필요, Stripe 미사용'"
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "test-builder Walkthrough 모드가 순서대로 실행. 각 step 의 action 은 Playwright MCP 도구로 1:1 매핑.",
      "items": {
        "type": "object",
        "required": ["seq", "action", "description"],
        "additionalProperties": false,
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1,
            "description": "1 부터 시작하는 단계 번호"
          },
          "action": {
            "type": "string",
            "enum": [
              "navigate",
              "fill",
              "click",
              "select",
              "type",
              "press_key",
              "wait",
              "screenshot",
              "assert",
              "evaluate",
              "upload",
              "hover"
            ],
            "description": "Playwright MCP 도구 매핑: navigate→browser_navigate, fill→browser_fill_form, click→browser_click, select→browser_select_option, type→browser_type, press_key→browser_press_key, wait→browser_wait_for, screenshot→browser_take_screenshot, evaluate→browser_evaluate, upload→browser_file_upload, hover→browser_hover, assert→테스트용 (browser_snapshot 후 검증)"
          },
          "url": {
            "type": "string",
            "description": "action=navigate 시 필수. 상대 경로 또는 절대 URL."
          },
          "selector": {
            "type": "string",
            "description": "action=fill/click/select/type/hover/upload/evaluate 시 권장. CSS / accessible role / text selector."
          },
          "value": {
            "type": "string",
            "description": "action=fill/type/select 시 입력값. 자격증명은 env 변수 표기 (예: '$TEST_USER_EMAIL')"
          },
          "key": {
            "type": "string",
            "description": "action=press_key 시 키 이름 (예: 'Enter', 'Escape')"
          },
          "wait_for": {
            "type": "string",
            "description": "action=wait 시 selector 또는 text 또는 network idle 조건"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "사람이 읽을 단계 설명 (한국어 권장)"
          }
        }
      }
    },
    "code_entry_points": {
      "type": "array",
      "description": "단계별 코드 진입점 매핑. qa-surveyor 단계 1 (코드 측량) 결과 활용.",
      "items": {
        "type": "object",
        "required": ["step", "location"],
        "additionalProperties": false,
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "location": {
            "type": "string",
            "description": "file:line 또는 route 경로 (예: 'src/app/catalog/page.tsx:42' 또는 'POST /catalog/categories/draft')"
          }
        }
      }
    },
    "expected_observations": {
      "type": "array",
      "minItems": 1,
      "description": "test-builder 가 실측 시 검증할 항목. PASS/FAIL 판정 기준.",
      "items": {
        "type": "object",
        "required": ["after_step", "expectation"],
        "additionalProperties": false,
        "properties": {
          "after_step": {
            "type": "integer",
            "minimum": 1,
            "description": "이 단계 직후 검증"
          },
          "expectation": {
            "type": "string",
            "minLength": 1,
            "description": "관찰될 것의 자연어 설명"
          },
          "kind": {
            "type": "string",
            "enum": [
              "ui_text",
              "modal_shown",
              "url_change",
              "http_status",
              "response_field",
              "state_change",
              "console_error",
              "screenshot_match"
            ],
            "description": "관찰 종류. test-builder 가 어떤 MCP 도구로 검증할지 결정."
          },
          "target": {
            "type": "string",
            "description": "검증 대상 (selector / URL pattern / 응답 JSON path 등)"
          },
          "value": {
            "type": "string",
            "description": "기대값. http_status 면 '200', ui_text 면 보일 텍스트."
          }
        }
      }
    },
    "regression_candidates": {
      "type": "array",
      "description": "happy path 외에 회귀 케이스로 박제할 시나리오 후보. test-builder PR 모드 (/qa test feat-inv-NNN) 가 자산화.",
      "items": {
        "type": "object",
        "required": ["summary"],
        "additionalProperties": false,
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": ["High", "Medium", "Low"]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
