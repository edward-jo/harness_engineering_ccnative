# 백엔드 환경 변수 템플릿
# .env 파일을 만들어 실제 값을 채워 사용하세요. 비어 있어도 앱은 정상 동작합니다(폴백).

# Anthropic Claude API 키 (AI 카테고리 분류/우선순위 추천/일일 브리핑에 사용)
# 키가 없어도 앱은 정상 동작하며, 모든 항목이 category="기타", priority="medium"으로 폴백됩니다.
ANTHROPIC_API_KEY=your_api_key_here

# 데이터베이스 접속 URL (기본값: SQLite 로컬 파일)
# 프로덕션에서는 PostgreSQL 등을 지정하세요. 예) postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./todos.db
